{
  "_comment": "The sync job holds the SSH key and can reach the backup server. Only its config decides what it uploads, and the assistant can edit that config.",
  "agents": {
    "assistant": { "read": ["web", "notes"], "write": ["notes", "cfg/sync"] },
    "reader":    { "read": ["notes", "docs", "home/.ssh"], "write": ["docs"] },
    "sync":      { "read": ["photos", "home/.ssh"], "write": ["net:backup"], "injectable": false,
                   "flows": [["photos", "net:backup"]] }
  },
  "resources": {
    "web":        { "untrusted": true },
    "notes":      {},
    "docs":       {},
    "photos":     {},
    "home/.ssh":  { "labels": ["ssh_key"] },
    "net:backup": { "sink": true },
    "cfg/sync":   { "controls": ["sync"], "access": true }
  }
}
