    "coder":    { "read": ["repo", "home/.ssh", "web"], "write": ["repo"],
                  "maybe": { "read": ["web"] } },
    "reviewer": { "read": ["repo"], "write": ["net:pr"] },
    "helper":   { "read": ["*"], "write": ["repo", "notes", "net:chat"], "unknown": true }
  },
  "resources": {
    "web":       { "untrusted": true },
    "repo":      {},
    "notes":     {},
    "home/.ssh": { "labels": ["ssh_key"] },
    "net:pr":    { "sink": true },
    "net:chat":  { "sink": true }
  }
}
